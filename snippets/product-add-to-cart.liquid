{%- assign variant_id = selected_variant_id -%}

<div class="block-{{ block.id }} tw:flex tw:flex-col tw:gap-2">
  <button
    type="submit"
    class="
      tw:w-full tw:bg-black tw:text-white tw:p-4 tw:rounded-lg
      tw:cursor-pointer tw:text-body-lg tw:leading-body-lg
      tw:hover:bg-gray-700 tw:focus-visible:bg-gray-700 tw:transition
      tw:disabled:bg-gray-300 tw:disabled:cursor-not-allowed
    "
    data-add-to-cart
    {% if variant_id == blank %}
      disabled
    {% endif %}
  >
    {{ 'products.product.add_to_cart' | t: default: 'Add to cart' }}
  </button>

  <div
    id="add-to-cart-error"
    class="tw:hidden tw:text-body-lg tw:leading-body-lg"
  >
    {{ 'products.product.select_size' | t | default: 'Select size' }}
  </div>
</div>
