<footer
  class="tw:p-15 tw:pb-6 tw:text-black"
  role="contentinfo"
  data-footer-accordion
>
  <div class="tw:grid tw:grid-cols-1 tw:sm:grid-cols-2 tw:lg:grid-cols-4 tw:gap-4 tw:gap-y-7 tw:lg:gap-2.5 tw:mb-12">
    {% for block in section.blocks %}
      <nav
        class="tw:border-b tw:border-gray-200 tw:sm:border-none tw:pb-4 tw:group"
        aria-labelledby="footer-title-{{ block.id }}"
        data-active="false"
        data-footer-item
      >
        <h3
          class="
            tw:mb-4!
            tw:group-data-active:mb-0
          "
          id="footer-title-{{ block.id }}"
        >
          <span class="tw:hidden tw:sm:block">
            {{ block.settings.title }}
          </span>

          <button
            class="
              tw:sm:hidden
              tw:w-full tw:flex tw:items-center tw:justify-between
              tw:relative tw:text-left tw:bg-transparent tw:border-none
              tw:group-data-active:pb-4
              tw:transition-all tw:duration-300
              tw:sm:pointer-events-none
            "
            type="button"
            aria-expanded="false"
            aria-controls="footer-list-{{ block.id }}"
            data-toggle-active
          >
            {{ block.settings.title }}
            <span
              class="
                tw:block tw:sm:hidden tw:w-3 tw:h-3
                tw:border-b tw:border-r tw:border-black
                tw:rotate-45 tw:transition-transform
                tw:group-data-active:rotate-220
              "
              aria-hidden="true"
            ></span>
          </button>
        </h3>

        <div
          class="
            tw:grid tw:grid-rows-0
            tw:transition-[grid-template-rows] tw:duration-300
            tw:sm:block
            tw:group-data-active:grid-rows-1
          "
        >
          <ul
            class="
              tw:max-h-0 tw:opacity-0 tw:overflow-hidden
              tw:sm:flex tw:sm:flex-col tw:sm:gap-3 tw:sm:max-h-full tw:sm:opacity-100 tw:sm:overflow-visible
              tw:transition-all tw:duration-300
              tw:group-data-active:max-h-92
              tw:group-data-active:opacity-100
            "
            id="footer-list-{{ block.id }}"
          >
            {% for link in block.settings.menu.links %}
              <li>
                <a
                  class="tw:text-gray-500 tw:transition tw:duration-300 tw:hover:text-black tw:focus-visible:text-black"
                  href="{{ link.url }}"
                >
                  {{- link.title -}}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </nav>
    {% endfor %}
  </div>

  <div class="tw:flex tw:flex-col tw:md:flex-row tw:gap-2.5 tw:md:gap-8 tw:items-start tw:lg:items-center tw:text-sm tw:text-black/70">
    <div>
      © {{ 'now' | date: '%Y' }}
      {{ shop.name }}. {{ 'footer.copyright' | t: default: 'All rights reserved.' }}
    </div>
    <div class="tw:flex tw:flex-col tw:sm:flex-row tw:gap-3 sm:tw:gap-6">
      <a href="#" class="tw:transition tw:duration-300 tw:hover:text-black tw:focus-visible:text-black">
        {{- 'footer.terms' | t: default: 'Terms of Use' -}}
      </a>
      <a href="#" class="tw:transition tw:duration-300 tw:hover:text-black tw:focus-visible:text-black">
        {{- 'footer.privacy' | t: default: 'Privacy Policy' -}}
      </a>
      <a href="#" class="tw:transition tw:duration-300 tw:hover:text-black tw:focus-visible:text-black">
        {{- 'footer.cookies' | t: default: 'Cookie Policy' -}}
      </a>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "column",
      "name": "Footer column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column title"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "settings": []
}
{% endschema %}
