<section
  class="product-recommendations"
  data-section="product-recommendations"
  data-product-id="{{ product.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="page-width">
    <h2
      class="
        tw:flex tw:justify-center
        tw:text-h2--mobile tw:leading-8 tw:mb-8!
        tw:md:mb-12! tw:md:text-h2 tw:md:leading-h2
      "
    >
      {{ section.settings.heading }}
    </h2>
    <div class="wrapper tw:relative">
      <div class="swiper js-product-recommendations-swiper">
        <div class="swiper-wrapper">
          {% if recommendations.performed and recommendations.products_count > 0 %}
            {% for product in recommendations.products %}
              <div class="swiper-slide">
                {% render 'product-card', product: product %}
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
      <button
        class="
          swiper-button-prev
          tw:w-10! tw:h-10! tw:bg-white tw:border tw:rounded-full tw:border-gray-200 tw:opacity-100
          tw:left-[-2%]! tw:rotate-180 tw:overflow-hidden
          tw:hover:bg-gray-300
          tw:[&.swiper-button-disabled]:opacity-0!
          tw:transition tw:duration-300 tw:ease-linear
        "
        aria-label="{{'a11y.swiper_prev' | t: default: 'Key to scroll back through the carousel' }}"
        type="button"
      >
        {% render 'icon', name: 'arrow-icon', class: 'tw:w-4! tw:h-4!' %}
      </button>
      <button
        class="
          swiper-button-next
          tw:w-10! tw:h-10! tw:bg-white tw:border tw:rounded-full tw:border-gray-200 tw:opacity-100
          tw:right-[-2%]! tw:overflow-hidden
          tw:hover:bg-gray-300
          tw:[&.swiper-button-disabled]:opacity-0!
          tw:transition tw:duration-300 tw:ease-linear
        "
        aria-label="{{'a11y.swiper_next' | t: default: 'Key to scroll forward through the carousel' }}"
        type="button"
      >
        {% render 'icon', name: 'arrow-icon', class: 'tw:w-4! tw:h-4!' %}
      </button>
    </div>
  </div>
</section>

{%- style -%}
  {% if section.settings.margin_top %}
    .product-recommendations {
      margin-top: {{ section.settings.margin_top }}px;
    }
  {% endif %}
  {% if section.settings.margin_bottom %}
    .product-recommendations {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  {% endif %}
{%- endstyle -%}

{% schema %}
{
  "name": "Product recommendations",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
