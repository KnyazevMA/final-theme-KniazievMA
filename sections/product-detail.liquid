{% liquid
  assign rating = 5.0
  assign current_variant = product.selected_or_first_available_variant
  assign description = product.metafields.custom.product_description_text
  assign guide = product.metafields.custom.size_guide.value
%}

<section class="product-detail" data-section-id="{{ section.id }}" data-section-type="product-detail">
  <div class="page-width">
    <div
      class="
        tw:grid tw:grid-cols-1 tw:gap-6
        tw:lg:grid-cols-2! tw:xl:gap-15
      "
    >
      {% render 'product-media', product: product %}
      <div>
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'title' %}
              <h1
                class="tw:text-h2--mobile tw:leading-8 tw:md:text-h2 tw:md:leading-h2  block-{{ block.id }}"
              >
                {{ product.title }}
              </h1>

            {% when 'rating' %}
              <div class="tw:flex tw:items-center tw:gap-1 block-{{ block.id }}">
                {% render 'review-stars', rating: rating %}
                <span class="tw:text-body-md tw:leading-body-md tw:text-neutral-700">
                  {{ rating }}
                </span>
              </div>

            {% when 'description' %}
              <p class="tw:text-gray-700 tw:text-body-md tw:leading-body-md tw:mb-6 block-{{ block.id }}">
                {{ product.description | strip_html | truncate: 300 }}
              </p>
          {% endcase %}
        {% endfor %}

        {%- form 'product', product, id: 'ProductForm' -%}
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'price' %}
                <div class="block-{{ block.id }} tw:flex tw:justify-between tw:items-center">
                  {% if current_variant.compare_at_price > current_variant.price %}
                    <div class="tw:flex tw:items-center tw:gap-1.5">
                      <span class="tw:text-body-lg tw:leading-body-lg tw:text-gray-700 tw:line-through">
                        {{ current_variant.compare_at_price | money }}
                      </span>
                      <span class="tw:text-body-lg tw:leading-body-lg">
                        {{ current_variant.price | money }}
                      </span>
                    </div>
                  {% else %}
                    <span class="tw:text-body-lg tw:block tw:leading-body-lg">
                      {{ current_variant.price | money }}
                    </span>
                  {% endif %}
                  <p class="tw:mt-3 tw:text-body-sm tw:leading-body-sm" data-availability-text>
                    {{ 'products.product.select_size' | t | escape | default: 'Please select a size' -}}
                  </p>
                </div>
              {% when 'color' %}
                {% render 'product-option-color',
                  product: product,
                  block: block,
                  legend: block.settings.color_label,
                  show_color_label: block.settings.show_color_label
                %}

              {% when 'size' %}
                {% render 'product-option-size',
                  product: product,
                  block: block,
                  label: block.settings.size_label,
                  show_size_label: block.settings.show_size_label
                %}

              {% when 'add_to_cart' %}
                {% render 'product-add-to-cart',
                  selected_variant_id: product.selected_or_first_available_variant.id,
                  block: block
                %}
            {% endcase %}
          {% endfor %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {%- endform -%}
        <div class="tw:flex tw:flex-col tw:gap-6 tw:mb-6! tw:md:mb-8!">
          <div class="tw:flex tw:flex-col tw:gap-3">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'shipping_info' %}
                  {% assign info = block.settings.shipping_info %}
                  {% if info %}
                    <div class="tw:flex tw:items-center tw:gap-1.5 tw:text-body-md tw:text-black">
                      {%- if info.icon != blank -%}
                        {{
                          info.icon
                          | image_url: width: 48
                          | image_tag:
                            widths: '24, 48',
                            sizes: '24px',
                            class: 'tw:w-6 tw:h-6 tw:flex-none',
                            alt: '',
                            loading: 'lazy'
                        }}
                      {%- endif -%}

                      {{ info.text }}
                    </div>
                  {% endif %}
              {% endcase %}
            {% endfor %}
          </div>
          <p class="tw:text-body-md tw:leading-body-md tw:text-gray-700">{{ description }}</p>
        </div>
        {% render 'product-accordion', product: product %}
      </div>
    </div>
  </div>
  {% if guide != blank %}
    {% render 'size-guide-modal', guide: guide %}
  {% endif %}
</section>

{%- style -%}
  {% for block in section.blocks %}
    .block-{{ block.id }} {
      {% if block.settings.margin_top %}
        margin-top: {{ block.settings.margin_top }}px;
      {% endif %}
      {% if block.settings.margin_bottom %}
        margin-bottom: {{ block.settings.margin_bottom }}px;
      {% endif %}
    }
  {% endfor %}
  {% if section.settings.margin_top %}
    .product-detail {
      margin-top: {{ section.settings.margin_top }}px;
    }
  {% endif %}
  {% if section.settings.margin_bottom %}
    .product-detail {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  {% endif %}
{%- endstyle -%}

<script>
  window.theme = window.theme || {};
  window.theme.strings = {
    inStock: "{{ 'products.product.in_stock' | t | escape | default: 'In Stock' }}",
    inStockQty: "{{ 'products.product.in_stock_qty' | t | escape | default: 'In Stock · ' }}",
    outOfStock: "{{ 'products.product.out_of_stock' | t | escape | default: 'Out of Stock' }}",
    soldOut: "{{ 'products.product.sold_out' | t | escape | default: 'Sorry, this product is out of stock' }}",
  };
</script>

