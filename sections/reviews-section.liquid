{%- liquid
  assign mf = product.metafields.custom.reviews_json
  assign reviews = blank

  if mf != blank
    assign reviews = mf.value
  endif
-%}
{%- if reviews != blank and reviews.size > 0 -%}
  <section class="reviews-section" data-section-id="{{ section.id }}" data-section-type="reviews">
    <div class="page-width">
      <h2
        class="
          tw:text-h2 tw:leading-h2 tw:mb-8!
          tw:text-center tw:text-black
          tw:md:text-h2 tw:md:leading-h2 tw:md:mb-12!
        "
      >
        {{ section.settings.heading }}
      </h2>

      <div class="tw:grid tw:grid-cols-1 tw:gap-4
        tw:md:grid-cols-3 tw:md:gap-6">
        {%- for review in reviews limit: 3 -%}
          {% render 'review-card', review: review %}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- style -%}
  {% if section.settings.margin_top %}
    .reviews-section {
      margin-top: {{ section.settings.margin_top }}px;
    }
  {% endif %}
  {% if section.settings.margin_bottom %}
    .reviews-section {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  {% endif %}
{%- endstyle -%}

{% schema %}
{
  "name": "Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reviews"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Reviews"
    }
  ]
}
{% endschema %}
